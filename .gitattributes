# Git LFS for binary art, models and audio. Text formats (.gltf, .svg, .tscn,
# .import, .tres) stay in normal Git so they diff and merge.
*.blend   filter=lfs diff=lfs merge=lfs -text
*.glb     filter=lfs diff=lfs merge=lfs -text
*.fbx     filter=lfs diff=lfs merge=lfs -text
*.bin     filter=lfs diff=lfs merge=lfs -text
*.wav     filter=lfs diff=lfs merge=lfs -text
*.ogg     filter=lfs diff=lfs merge=lfs -text
*.mp3     filter=lfs diff=lfs merge=lfs -text
*.flac    filter=lfs diff=lfs merge=lfs -text
*.exr     filter=lfs diff=lfs merge=lfs -text
*.hdr     filter=lfs diff=lfs merge=lfs -text
*.psd     filter=lfs diff=lfs merge=lfs -text
*.kra     filter=lfs diff=lfs merge=lfs -text
*.spp     filter=lfs diff=lfs merge=lfs -text
*.ttf     filter=lfs diff=lfs merge=lfs -text
*.otf     filter=lfs diff=lfs merge=lfs -text
*.woff2   filter=lfs diff=lfs merge=lfs -text
# Textures and art images, only inside the asset folders (concept art in codex/ is unchanged).
art/**/*.png          filter=lfs diff=lfs merge=lfs -text
art/**/*.jpg          filter=lfs diff=lfs merge=lfs -text
art/**/*.tga          filter=lfs diff=lfs merge=lfs -text
art/**/*.tif          filter=lfs diff=lfs merge=lfs -text
game/assets/**/*.png  filter=lfs diff=lfs merge=lfs -text
game/assets/**/*.jpg  filter=lfs diff=lfs merge=lfs -text
game/assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
game/assets/**/*.tga  filter=lfs diff=lfs merge=lfs -text
asset-hub/data/blobs/** filter=lfs diff=lfs merge=lfs -text
