; Engine configuration file.
; Orbit Royale: Godot 4 project. Start with scenes/playground.tscn.

config_version=5

[application]

config/name="Orbit Royale"
config/description="Combat slice and movement playground"
run/main_scene="res://scenes/ringfall.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Controls="*res://scripts/controls.gd"
Perf="*res://scripts/perf.gd"
TuningPanel="*res://scripts/ui/tuning_panel.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="grappable"
3d_physics/layer_3="player"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1

[importer_defaults]

texture={
"compress/lossy_quality": 0.75,
"process/size_limit": 1024,
"compress/mode": 1,
"detect_3d/compress_to": 0
}
